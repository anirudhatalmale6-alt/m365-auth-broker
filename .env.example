# Copy to .env and fill in. None of these are secrets: a desktop app is a
# public OAuth client and has no client secret by design (see docs/SECURITY.md).

# Application (client) ID from the Entra ID app registration. Required.
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Which accounts may sign in:
#   common        - work/school or personal Microsoft accounts
#   organizations - work/school accounts only
#   consumers     - personal accounts only
#   <tenant guid> - one organisation only
M365_TENANT=common

# Space separated. offline_access is what enables silent renewal - removing it
# means the user is sent back to the browser roughly every hour.
M365_SCOPES=offline_access openid profile User.Read Mail.Read Mail.Send

# Leave unset so the OS picks a free loopback port at sign-in time. Only set
# this if your app registration pins an exact redirect URI, and register
# http://localhost:<port>/callback to match.
# M365_REDIRECT_PORT=5580

# Sovereign clouds only (US Government, 21Vianet).
# M365_AUTHORITY=https://login.microsoftonline.com
# M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
